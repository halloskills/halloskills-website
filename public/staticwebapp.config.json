{
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/images/*", "/favicon.ico", "/sitemap.xml", "/robots.txt"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "routes": [
    {
      "route": "/coming-soon.html"
    },
    {
      "route": "/*",
      "rewrite": "/coming-soon.html"
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
